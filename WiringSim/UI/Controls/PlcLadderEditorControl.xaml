<UserControl x:Class="WiringSim.UI.Controls.PlcLadderEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource SurfaceBgBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Focusable="True"
             PreviewKeyDown="OnEditorPreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0. EMBEDDED HEADER BAR -->
        <Border x:Name="EmbeddedHeaderBar"
                Grid.Row="0"
                Background="{DynamicResource TitleBarBgBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,6">
            <DockPanel LastChildFill="True">
                <Button x:Name="BtnHideEditor"
                        DockPanel.Dock="Right"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Padding="8,3"
                        FontSize="11"
                        Content="✕"
                        Click="OnHideEditorClick"
                        ToolTip="{DynamicResource Str.Plc.HideEditorTip}" />

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#009999" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                        <TextBlock Text="PLC" FontSize="10" FontWeight="Bold" Foreground="White" />
                    </Border>
                    <TextBlock x:Name="TxtPlcHeader"
                               Text="{DynamicResource Str.Plc.EditorTitle}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 1. PRIMARY TOOLBAR: TABS (LADDER / TAGS / WATCH), UNDO/REDO, COMPILE, DOWNLOAD, CPU, DISPLAY MODE, SYSTEM/CLOCK -->
        <Border Grid.Row="1"
                Background="{DynamicResource ToolbarBgBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,5">
            <DockPanel LastChildFill="True">
                <!-- Fixed Right: CPU State + ONLINE + Instructions Toggle -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Border x:Name="CpuStatePill"
                            Background="#059669"
                            CornerRadius="4"
                            Padding="7,2.5"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="TxtCpuState" Text="RUN" FontSize="9.8" FontWeight="Bold" Foreground="White" />
                    </Border>
                    <Border x:Name="ForcePill"
                            Background="#DC2626"
                            BorderBrush="#FCA5A5"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,2"
                            Margin="0,0,6,0"
                            Visibility="Collapsed"
                            VerticalAlignment="Center"
                            ToolTip="{DynamicResource Str.Plc.ForceBadgeTip}">
                        <TextBlock Text="F" FontSize="9.8" FontWeight="ExtraBold" Foreground="White" />
                    </Border>
                    <Border x:Name="OnlinePill"
                            Background="#15803D"
                            BorderBrush="#4ADE80"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,2"
                            Margin="0,0,6,0"
                            Visibility="Collapsed"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="TxtOnlinePill" Text="● ONLINE" FontSize="9.5" FontWeight="Bold" Foreground="#DCFCE7" />
                    </Border>
                    <Button x:Name="BtnToggleInstructions"
                            Style="{StaticResource ToolbarButtonStyle}"
                            BorderBrush="{DynamicResource AccentCyanBrush}"
                            Padding="9,4"
                            FontSize="11"
                            Click="OnToggleInstructionsClick"
                            Content="{DynamicResource Str.Plc.ToggleInstructions}" />
                </StackPanel>

                <!-- Left Scrollable Primary Controls -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="RbTabLadder"
                                     GroupName="PlcEditorTabs"
                                     Style="{StaticResource ModeSwitchRadioStyle}"
                                     Tag="#0284C7"
                                     IsChecked="True"
                                     Checked="OnTabChanged"
                                     Content="{DynamicResource Str.Plc.TabLadder}"
                                     Margin="0,0,3,0" />
                        <RadioButton x:Name="RbTabTags"
                                     GroupName="PlcEditorTabs"
                                     Style="{StaticResource ModeSwitchRadioStyle}"
                                     Tag="#009999"
                                     Checked="OnTabChanged"
                                     Content="{DynamicResource Str.Plc.TabTags}"
                                     Margin="0,0,3,0" />
                        <RadioButton x:Name="RbTabWatch"
                                     GroupName="PlcEditorTabs"
                                     Style="{StaticResource ModeSwitchRadioStyle}"
                                     Tag="#7C3AED"
                                     Checked="OnTabChanged"
                                     Content="{DynamicResource Str.Plc.TabWatch}"
                                     Margin="0,0,3,0" />
                        <RadioButton x:Name="RbTabForce"
                                     GroupName="PlcEditorTabs"
                                     Style="{StaticResource ModeSwitchRadioStyle}"
                                     Tag="#DC2626"
                                     Checked="OnTabChanged"
                                     Content="{DynamicResource Str.Plc.TabForce}"
                                     Margin="0,0,3,0" />
                        <RadioButton x:Name="RbTabDiag"
                                     GroupName="PlcEditorTabs"
                                     Style="{StaticResource ModeSwitchRadioStyle}"
                                     Tag="#D97706"
                                     Checked="OnTabChanged"
                                     Content="{DynamicResource Str.Plc.TabDiag}"
                                     Margin="0,0,6,0" />

                        <Rectangle Width="1" Height="18" Fill="{DynamicResource DividerBrush}" Margin="2,0,6,0" />

                        <Button x:Name="BtnUndo"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Padding="6,3.5"
                                Margin="0,0,3,0"
                                FontSize="11"
                                Content="↶"
                                IsEnabled="False"
                                ToolTip="{DynamicResource Str.Toolbar.UndoTip}"
                                Click="OnUndoClick" />
                        <Button x:Name="BtnRedo"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Padding="6,3.5"
                                Margin="0,0,6,0"
                                FontSize="11"
                                Content="↷"
                                IsEnabled="False"
                                ToolTip="{DynamicResource Str.Toolbar.RedoTip}"
                                Click="OnRedoClick" />

                        <Rectangle Width="1" Height="18" Fill="{DynamicResource DividerBrush}" Margin="0,0,6,0" />

                        <Button x:Name="BtnCompile"
                                Style="{StaticResource ToolbarButtonStyle}"
                                BorderBrush="#F59E0B"
                                Padding="7,3.5"
                                Margin="0,0,4,0"
                                FontSize="11"
                                Click="OnCompileClick"
                                ToolTip="{DynamicResource Str.Plc.CompileTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙ " Foreground="#F59E0B" />
                                <TextBlock Text="{DynamicResource Str.Plc.Compile}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnDownload"
                                Style="{StaticResource ToolbarButtonStyle}"
                                BorderBrush="#10B981"
                                Padding="7,3.5"
                                Margin="0,0,5,0"
                                FontSize="11"
                                Click="OnDownloadClick"
                                ToolTip="{DynamicResource Str.Plc.DownloadTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⬇ " Foreground="#10B981" />
                                <TextBlock Text="{DynamicResource Str.Plc.Download}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnCpuRun"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Padding="6,3.5"
                                Margin="0,0,3,0"
                                FontSize="11"
                                Content="▶"
                                ToolTip="RUN"
                                Foreground="#22C55E"
                                Click="OnCpuRunClick" />
                        <Button x:Name="BtnCpuStop"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Padding="6,3.5"
                                Margin="0,0,6,0"
                                FontSize="11"
                                Content="⏹"
                                ToolTip="STOP"
                                Foreground="#F59E0B"
                                Click="OnCpuStopClick" />

                        <Rectangle Width="1" Height="18" Fill="{DynamicResource DividerBrush}" Margin="0,0,6,0" />

                        <!-- 3 Chế độ hiển thị địa chỉ -->
                        <Button x:Name="BtnDisplayMode"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Padding="7,3.5"
                                Margin="0,0,4,0"
                                FontSize="10.6"
                                Click="OnCycleDisplayModeClick"
                                ToolTip="{DynamicResource Str.Plc.DisplayModeTip}" />

                        <!-- Cấu hình System & Clock Memory / Watchdog / STOP Output -->
                        <Button x:Name="BtnPlcMemConfig"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Padding="7,3.5"
                                Margin="0,0,4,0"
                                FontSize="10.6"
                                Content="{DynamicResource Str.Plc.SysClkBtn}"
                                ToolTip="{DynamicResource Str.Plc.SysClkTip}"
                                Click="OnOpenMemConfigClick" />

                        <!-- Xuất / Nhập chương trình dạng văn bản có cấu trúc (.plctxt) -->
                        <Button x:Name="BtnExportText"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Padding="7,3.5"
                                Margin="0,0,3,0"
                                FontSize="10.6"
                                Content="{DynamicResource Str.Plc.ExportTextBtn}"
                                ToolTip="{DynamicResource Str.Plc.ExportTextTip}"
                                Click="OnExportTextClick" />
                        <Button x:Name="BtnImportText"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Padding="7,3.5"
                                FontSize="10.6"
                                Content="{DynamicResource Str.Plc.ImportTextBtn}"
                                ToolTip="{DynamicResource Str.Plc.ImportTextTip}"
                                Click="OnImportTextClick" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 2. FAVORITES TOOLBAR (KÉO THẢ LỆNH TỪ THƯ VIỆN VÀO ĐỂ GHIM / BỎ GHIM) -->
        <Border x:Name="FavoritesToolbarBorder"
                Grid.Row="2"
                Background="{DynamicResource SubtleSurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,4"
                AllowDrop="True"
                DragOver="OnFavoritesDragOver"
                Drop="OnFavoritesDrop">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left"
                           Text="{DynamicResource Str.Plc.FavoritesLabel}"
                           FontSize="10.2"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AccentCyanBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Lệnh cấu trúc cố định -->
                        <Button x:Name="BtnAddNetwork"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Padding="7,3"
                                Margin="0,0,4,0"
                                FontSize="10.6"
                                Content="{DynamicResource Str.Plc.AddNetwork}"
                                ToolTip="Shift+F2"
                                Click="OnAddNetworkClick" />
                        <Button x:Name="BtnOpenBranch"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Padding="7,3"
                                Margin="0,0,4,0"
                                FontSize="10.6"
                                Content="{DynamicResource Str.Plc.OpenBranch}"
                                ToolTip="Shift+F8"
                                Click="OnOpenParallelBranchClick" />
                        <Button x:Name="BtnCloseBranch"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Padding="7,3"
                                Margin="0,0,4,0"
                                FontSize="10.6"
                                Content="{DynamicResource Str.Plc.CloseBranch}"
                                ToolTip="Shift+F9"
                                Click="OnCloseParallelBranchClick" />
                        <Button x:Name="BtnEmptyBox"
                                Style="{StaticResource ToolbarButtonStyle}"
                                BorderBrush="#38BDF8"
                                Padding="7,3"
                                Margin="0,0,6,0"
                                FontSize="10.6"
                                Content="{DynamicResource Str.Plc.EmptyBoxBtn}"
                                ToolTip="F8"
                                Click="OnInsertEmptyBoxClick" />

                        <Rectangle Width="1" Height="16" Fill="{DynamicResource DividerBrush}" Margin="0,0,6,0" />

                        <!-- Các lệnh ghim Favorites (có thể kéo thả để thêm, chuột phải để bỏ ghim) -->
                        <StackPanel x:Name="FavoritesItemsPanel" Orientation="Horizontal" VerticalAlignment="Center" />

                        <Border Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,2"
                                Margin="4,0,6,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Str.Plc.FavoritesDropHint}"
                                       FontSize="9.6"
                                       FontStyle="Italic"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </Border>

                        <Button x:Name="BtnDeleteNode"
                                Style="{StaticResource DangerToolbarButtonStyle}"
                                Padding="7,3"
                                FontSize="10.6"
                                Content="{DynamicResource Str.Plc.DelNode}"
                                ToolTip="Delete"
                                Click="OnDeleteSelectedNodeClick" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 3. MAIN WORKSPACE: 10-GROUP SEARCHABLE INSTRUCTION TREE + LADDER / TAG TABLE / WATCH TABLE -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="InstructionsColumn" Width="264" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 3A. CÂY THƯ VIỆN 10 NHÓM LỆNH PLC -->
            <Border x:Name="InstructionsPanelBorder"
                    Grid.Column="0"
                    Background="{DynamicResource SubtleSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="7,6,7,5">
                        <TextBlock Text="{DynamicResource Str.Plc.InstrHeader}"
                                   FontSize="10.2"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentCyanBrush}"
                                   Margin="0,0,0,5" />
                        <Grid>
                            <TextBox x:Name="TbInstructionSearch"
                                     Padding="6,4,22,4"
                                     FontSize="11"
                                     Background="{DynamicResource InputBgBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource ButtonBorderBrush}"
                                     TextChanged="OnInstructionSearchChanged" />
                            <TextBlock x:Name="TxtSearchPlaceholder"
                                       Text="{DynamicResource Str.Plc.SearchHint}"
                                       FontSize="10.4"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Margin="8,0,22,0" />
                            <Button x:Name="BtnClearSearch"
                                    Content="✕"
                                    Width="18"
                                    Height="18"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,3,0"
                                    Padding="0"
                                    FontSize="9.5"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Cursor="Hand"
                                    Visibility="Collapsed"
                                    Click="OnClearSearchClick" />
                        </Grid>
                    </StackPanel>

                    <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource BorderSubtleBrush}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="5,4">
                        <StackPanel x:Name="InstructionsStack" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 3B. WORKSPACE VIEWS: LADDER OB1 | PLC TAGS | WATCH TABLE -->
            <Grid Grid.Column="1">
                <TextBlock x:Name="TxtNoPlcPlaceholder"
                           Text="{DynamicResource Str.Plc.NoPlcSelected}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="24"
                           FontSize="12.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Visibility="Collapsed" />

                <!-- TAB 1: LADDER (OB1 / OB100 / FC / FB) -->
                <Grid x:Name="LadderWorkspaceGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Thanh chọn khối chương trình (OB1 / OB100 / FC / FB) -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource SubtleSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="8,4">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="{DynamicResource Str.Plc.BlockLabel}"
                                       FontSize="10.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentCyanBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <ComboBox x:Name="CbActiveBlock"
                                      Width="195"
                                      FontSize="11"
                                      FontFamily="Consolas"
                                      Margin="0,0,6,0"
                                      SelectionChanged="OnActiveBlockSelectionChanged" />
                            <Button Style="{StaticResource ToolbarButtonStyle}"
                                    Padding="7,2.5"
                                    Margin="0,0,4,0"
                                    FontSize="10.4"
                                    Content="{DynamicResource Str.Plc.BlockAddOb100}"
                                    Click="OnAddOb100BlockClick" />
                            <Button Style="{StaticResource ToolbarButtonStyle}"
                                    Padding="7,2.5"
                                    Margin="0,0,4,0"
                                    FontSize="10.4"
                                    Content="{DynamicResource Str.Plc.BlockAddFc}"
                                    Click="OnAddFcBlockClick" />
                            <Button Style="{StaticResource ToolbarButtonStyle}"
                                    Padding="7,2.5"
                                    Margin="0,0,6,0"
                                    FontSize="10.4"
                                    Content="{DynamicResource Str.Plc.BlockAddFb}"
                                    Click="OnAddFbBlockClick" />
                            <Button x:Name="BtnDeleteActiveBlock"
                                    Style="{StaticResource DangerToolbarButtonStyle}"
                                    Padding="7,2.5"
                                    FontSize="10.4"
                                    IsEnabled="False"
                                    Content="{DynamicResource Str.Plc.BlockDelete}"
                                    Click="OnDeleteActiveBlockClick" />
                        </DockPanel>
                    </Border>

                    <ScrollViewer x:Name="LadderScrollViewer"
                                  Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Background="{DynamicResource AppBgBrush}"
                                  PreviewMouseWheel="OnLadderPreviewMouseWheel"
                                  Padding="10">
                        <StackPanel x:Name="NetworksContainer" HorizontalAlignment="Left">
                            <StackPanel.LayoutTransform>
                                <ScaleTransform x:Name="LadderZoomTransform" ScaleX="1.0" ScaleY="1.0" />
                            </StackPanel.LayoutTransform>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- TAB 2: PLC TAGS TABLE -->
                <Grid x:Name="TagTableContainer" Visibility="Collapsed" Background="{DynamicResource AppBgBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="10,6">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Style="{StaticResource ToolbarButtonStyle}" Padding="9,4" Margin="0,0,6,0" Content="{DynamicResource Str.Plc.TagAdd}" Click="OnAddTagClick" />
                                <Button Style="{StaticResource DangerToolbarButtonStyle}" Padding="9,4" Content="{DynamicResource Str.Plc.TagDelete}" Click="OnDeleteTagClick" />
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Str.Plc.TagEnterTip}"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Margin="12,0,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="10">
                        <StackPanel x:Name="TagRowsStack" MinWidth="820" />
                    </ScrollViewer>
                </Grid>

                <!-- TAB 3: WATCH TABLE (BẢNG THEO DÕI & ÉP GIÁ TRỊ TRỰC TUYẾN) -->
                <Grid x:Name="WatchTableContainer" Visibility="Collapsed" Background="{DynamicResource AppBgBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="10,6">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Style="{StaticResource ToolbarButtonStyle}" Padding="9,4" Margin="0,0,6,0" Content="{DynamicResource Str.Plc.WatchAdd}" Click="OnAddWatchRowClick" />
                                <Button Style="{StaticResource ToolbarButtonStyle}" BorderBrush="#10B981" Padding="9,4" Margin="0,0,6,0" Content="{DynamicResource Str.Plc.WatchModifyAll}" Click="OnModifyAllWatchClick" />
                                <Button Style="{StaticResource ToolbarButtonStyle}" Padding="9,4" Margin="0,0,6,0" Content="{DynamicResource Str.Plc.WatchClearForce}" Click="OnClearWatchOverridesClick" />
                                <Button Style="{StaticResource DangerToolbarButtonStyle}" Padding="9,4" Content="{DynamicResource Str.Plc.WatchDelete}" Click="OnDeleteWatchRowClick" />
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Str.Plc.WatchTip}"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Margin="12,0,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="10">
                        <StackPanel x:Name="WatchRowsStack" MinWidth="780" />
                    </ScrollViewer>
                </Grid>

                <!-- TAB 4: FORCE TABLE (BẢNG ÉP CỨNG NGOẠI VI :P) -->
                <Grid x:Name="ForceTableContainer" Visibility="Collapsed" Background="{DynamicResource AppBgBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="10,6">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Style="{StaticResource ToolbarButtonStyle}" Padding="9,4" Margin="0,0,6,0" Content="{DynamicResource Str.Plc.ForceAdd}" Click="OnAddForceRowClick" />
                                <Button Style="{StaticResource ToolbarButtonStyle}" BorderBrush="#DC2626" Padding="9,4" Margin="0,0,6,0" Content="{DynamicResource Str.Plc.ForceStart}" Click="OnStartForceClick" />
                                <Button Style="{StaticResource ToolbarButtonStyle}" Padding="9,4" Margin="0,0,6,0" Content="{DynamicResource Str.Plc.ForceStopAll}" Click="OnStopAllForceClick" />
                                <Button Style="{StaticResource DangerToolbarButtonStyle}" Padding="9,4" Content="{DynamicResource Str.Plc.ForceDelete}" Click="OnDeleteForceRowClick" />
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Str.Plc.ForceTip}"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Margin="12,0,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="10">
                        <StackPanel x:Name="ForceRowsStack" MinWidth="720" />
                    </ScrollViewer>
                </Grid>

                <!-- TAB 5: DIAGNOSTICS BUFFER (NHẬT KÝ CHẨN ĐOÁN CPU) -->
                <Grid x:Name="DiagnosticsContainer" Visibility="Collapsed" Background="{DynamicResource AppBgBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="10,6">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Left" Style="{StaticResource DangerToolbarButtonStyle}" Padding="9,4" Content="{DynamicResource Str.Plc.DiagClear}" Click="OnClearDiagnosticsClick" />
                            <TextBlock Text="{DynamicResource Str.Plc.DiagTip}"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Margin="12,0,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="10">
                        <StackPanel x:Name="DiagRowsStack" MinWidth="740" />
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- 4. THANH CHỈNH SỬA NHANH THAM SỐ PHẦN TỬ ĐANG CHỌN -->
        <Border x:Name="PropertyEditBar"
                Grid.Row="4"
                Background="{DynamicResource SubtleSurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,1"
                Padding="8,5">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock x:Name="TxtSelectedNodeSummary"
                           Text="{DynamicResource Str.Plc.DoubleClickHint}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentCyanBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />

                <StackPanel x:Name="PanelPropDataType" Orientation="Horizontal" Margin="0,2,8,2" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource Str.Plc.PropType}" FontSize="10.8" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <ComboBox x:Name="CbPropDataType" Width="80" FontSize="11" FontFamily="Consolas" SelectionChanged="OnPropDataTypeChanged" />
                </StackPanel>

                <StackPanel x:Name="PanelPropAddress" Orientation="Horizontal" Margin="0,2,8,2" Visibility="Collapsed">
                    <TextBlock x:Name="LblPropAddress" Text="{DynamicResource Str.Plc.PropAddr}" FontSize="10.8" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox x:Name="TbPropAddress" Width="116" Padding="4,2" FontFamily="Consolas" FontSize="11.2" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource ButtonBorderBrush}" KeyDown="OnPropTextBoxKeyDown" />
                    <Button x:Name="BtnPickPropAddress" Content="▾" Width="20" Padding="0" Margin="2,0,0,0" FontSize="10" Style="{StaticResource ToolbarButtonStyle}" Tag="Address" Click="OnOpenAutocompleteFromPropClick" />
                </StackPanel>

                <StackPanel x:Name="PanelPropSymbol" Orientation="Horizontal" Margin="0,2,8,2" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource Str.Plc.PropTag}" FontSize="10.8" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox x:Name="TbPropSymbol" Width="96" Padding="4,2" FontSize="11.2" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource ButtonBorderBrush}" KeyDown="OnPropTextBoxKeyDown" />
                </StackPanel>

                <StackPanel x:Name="PanelPropParam1" Orientation="Horizontal" Margin="0,2,8,2" Visibility="Collapsed">
                    <TextBlock x:Name="LblPropParam1" Text="{DynamicResource Str.Plc.PropParam1}" FontSize="10.8" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox x:Name="TbPropParam1" Width="90" Padding="4,2" FontFamily="Consolas" FontSize="11.2" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource ButtonBorderBrush}" KeyDown="OnPropTextBoxKeyDown" />
                    <Button Content="▾" Width="20" Padding="0" Margin="2,0,0,0" FontSize="10" Style="{StaticResource ToolbarButtonStyle}" Tag="Param1" Click="OnOpenAutocompleteFromPropClick" />
                </StackPanel>

                <StackPanel x:Name="PanelPropParam2" Orientation="Horizontal" Margin="0,2,8,2" Visibility="Collapsed">
                    <TextBlock x:Name="LblPropParam2" Text="{DynamicResource Str.Plc.PropParam2}" FontSize="10.8" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox x:Name="TbPropParam2" Width="90" Padding="4,2" FontFamily="Consolas" FontSize="11.2" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource ButtonBorderBrush}" KeyDown="OnPropTextBoxKeyDown" />
                    <Button Content="▾" Width="20" Padding="0" Margin="2,0,0,0" FontSize="10" Style="{StaticResource ToolbarButtonStyle}" Tag="Param2" Click="OnOpenAutocompleteFromPropClick" />
                </StackPanel>

                <StackPanel x:Name="PanelPropExtra" Orientation="Horizontal" Margin="0,2,8,2" Visibility="Collapsed">
                    <TextBlock x:Name="LblPropExtra" Text="{DynamicResource Str.Plc.PropExtra}" FontSize="10.8" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox x:Name="TbPropExtra" Width="116" Padding="4,2" FontFamily="Consolas" FontSize="11.2" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource ButtonBorderBrush}" KeyDown="OnPropTextBoxKeyDown" />
                </StackPanel>

                <StackPanel x:Name="PanelPropOut" Orientation="Horizontal" Margin="0,2,8,2" Visibility="Collapsed">
                    <TextBlock x:Name="LblPropOut" Text="{DynamicResource Str.Plc.PropOut}" FontSize="10.8" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox x:Name="TbPropOut" Width="90" Padding="4,2" FontFamily="Consolas" FontSize="11.2" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource ButtonBorderBrush}" KeyDown="OnPropTextBoxKeyDown" />
                    <Button Content="▾" Width="20" Padding="0" Margin="2,0,0,0" FontSize="10" Style="{StaticResource ToolbarButtonStyle}" Tag="Out" Click="OnOpenAutocompleteFromPropClick" />
                </StackPanel>

                <Button x:Name="BtnEditEquation"
                        Style="{StaticResource ToolbarButtonStyle}"
                        BorderBrush="#EC4899"
                        Padding="8,2.5"
                        Margin="0,2,6,2"
                        FontSize="10.8"
                        Visibility="Collapsed"
                        Content="{DynamicResource Str.Plc.EditEquationBtn}"
                        Click="OnEditEquationClick" />

                <Button x:Name="BtnInsertPinInput"
                        Style="{StaticResource ToolbarButtonStyle}"
                        BorderBrush="#38BDF8"
                        Padding="8,2.5"
                        Margin="0,2,6,2"
                        FontSize="10.8"
                        Visibility="Collapsed"
                        Content="{DynamicResource Str.Plc.InsertPinBtn}"
                        Click="OnInsertBoxInputPinClick" />

                <Button x:Name="BtnInsertPinOutput"
                        Style="{StaticResource ToolbarButtonStyle}"
                        BorderBrush="#A855F7"
                        Padding="8,2.5"
                        Margin="0,2,6,2"
                        FontSize="10.8"
                        Visibility="Collapsed"
                        Content="{DynamicResource Str.Plc.InsertOutPinBtn}"
                        Click="OnInsertBoxOutputPinClick" />

                <Button x:Name="BtnApplyNodeProps"
                        Style="{StaticResource ToolbarButtonStyle}"
                        BorderBrush="{DynamicResource AccentBlueBrush}"
                        Padding="9,2.5"
                        Margin="0,2,0,2"
                        FontSize="10.8"
                        Visibility="Collapsed"
                        Content="{DynamicResource Str.Plc.PropApply}"
                        Click="OnApplyNodePropsClick" />
            </WrapPanel>
        </Border>

        <!-- 5. COMPILER OUTPUT + DOWNLOAD PROGRESS + ZOOM CONTROLS -->
        <Border Grid.Row="5"
                Background="{DynamicResource ToolbarBgBrush}"
                Padding="8,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ProgressBar x:Name="DownloadProgressBar"
                             Grid.Row="0"
                             Height="5"
                             Minimum="0"
                             Maximum="100"
                             Foreground="#10B981"
                             Background="{DynamicResource InputBgBrush}"
                             BorderThickness="0"
                             Margin="0,0,0,5"
                             Visibility="Collapsed" />

                <DockPanel Grid.Row="1" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="Zoom" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Slider x:Name="SliderLadderZoom"
                                Width="92"
                                Minimum="50"
                                Maximum="200"
                                Value="100"
                                TickFrequency="25"
                                IsSnapToTickEnabled="False"
                                VerticalAlignment="Center"
                                ValueChanged="OnZoomSliderValueChanged" />
                        <ComboBox x:Name="CbLadderZoom"
                                  Width="68"
                                  Margin="6,0,0,0"
                                  FontSize="11"
                                  SelectionChanged="OnZoomComboChanged">
                            <ComboBoxItem Content="50%" Tag="50" />
                            <ComboBoxItem Content="75%" Tag="75" />
                            <ComboBoxItem Content="100%" Tag="100" IsSelected="True" />
                            <ComboBoxItem Content="125%" Tag="125" />
                            <ComboBoxItem Content="150%" Tag="150" />
                            <ComboBoxItem Content="200%" Tag="200" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock x:Name="TxtCompileSummary"
                                   FontSize="11.2"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <ScrollViewer x:Name="DiagnosticsScroller" MaxHeight="74" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Margin="0,4,0,0">
                            <StackPanel x:Name="DiagnosticsStack" />
                        </ScrollViewer>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <!-- POPUP 1: ADDRESS PICKER -->
        <Popup x:Name="AddressPickerPopup"
               StaysOpen="False"
               AllowsTransparency="True"
               Placement="Bottom"
               VerticalOffset="2">
            <Border Background="{DynamicResource SurfaceBgBrush}"
                    BorderBrush="{DynamicResource AccentCyanBrush}"
                    BorderThickness="1.4"
                    CornerRadius="6"
                    Padding="10"
                    Width="268">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.35" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.Plc.AddrPickerTitle}"
                               FontSize="11.2"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentCyanBrush}"
                               Margin="0,0,0,8" />

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="128" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Str.Plc.AddrOpId}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <ComboBox x:Name="CbAddrOpId" Grid.Column="1" FontSize="11.2" FontFamily="Consolas" SelectionChanged="OnAddressPickerFieldChanged">
                            <ComboBoxItem Content="I" />
                            <ComboBoxItem Content="Q" />
                            <ComboBoxItem Content="M" />
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="128" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Str.Plc.AddrOpType}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <ComboBox x:Name="CbAddrOpType" Grid.Column="1" FontSize="11.2" SelectionChanged="OnAddressPickerFieldChanged">
                            <ComboBoxItem Content="Bit" />
                            <ComboBoxItem Content="Byte" />
                            <ComboBoxItem Content="Word" />
                            <ComboBoxItem Content="DWord" />
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="128" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Str.Plc.AddrByte}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBox x:Name="TbAddrByte" Grid.Column="1" Padding="5,3" FontFamily="Consolas" FontSize="11.2" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource ButtonBorderBrush}" TextChanged="OnAddressPickerByteChanged" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="128" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Str.Plc.AddrBit}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <ComboBox x:Name="CbAddrBit" Grid.Column="1" FontSize="11.2" FontFamily="Consolas" SelectionChanged="OnAddressPickerFieldChanged">
                            <ComboBoxItem Content="0" />
                            <ComboBoxItem Content="1" />
                            <ComboBoxItem Content="2" />
                            <ComboBoxItem Content="3" />
                            <ComboBoxItem Content="4" />
                            <ComboBoxItem Content="5" />
                            <ComboBoxItem Content="6" />
                            <ComboBoxItem Content="7" />
                        </ComboBox>
                    </Grid>

                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="✓"
                                    Width="32"
                                    Height="26"
                                    Padding="0"
                                    Margin="0,0,5,0"
                                    FontSize="12.5"
                                    FontWeight="Bold"
                                    Foreground="#22C55E"
                                    BorderBrush="#22C55E"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="OnAddressPickerConfirmClick" />
                            <Button Content="✕"
                                    Width="32"
                                    Height="26"
                                    Padding="0"
                                    FontSize="11.5"
                                    Style="{StaticResource DangerToolbarButtonStyle}"
                                    Click="OnAddressPickerCancelClick" />
                        </StackPanel>
                        <TextBlock x:Name="TxtAddrPickerPreview"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#2DD4BF"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- POPUP 2: 3-COLUMN TAG / DB / SLICE / SYSTEM & CLOCK AUTOCOMPLETE -->
        <Popup x:Name="TagAutocompletePopup"
               StaysOpen="False"
               AllowsTransparency="True"
               Placement="Bottom"
               VerticalOffset="2">
            <Border Background="{DynamicResource SurfaceBgBrush}"
                    BorderBrush="{DynamicResource AccentCyanBrush}"
                    BorderThickness="1.4"
                    CornerRadius="6"
                    Padding="8"
                    Width="390">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.38" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <TextBox x:Name="TbAutoSearch"
                                 Padding="7,4"
                                 FontFamily="Consolas"
                                 FontSize="11.5"
                                 Background="{DynamicResource InputBgBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource AccentCyanBrush}"
                                 TextChanged="OnAutoSearchTextChanged"
                                 PreviewKeyDown="OnAutoSearchPreviewKeyDown" />
                        <TextBlock x:Name="TxtAutoSearchHint"
                                   Text="{DynamicResource Str.Plc.AutoSearchHint}"
                                   FontSize="10.4"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Margin="9,0,8,0" />
                    </Grid>

                    <Border x:Name="AutoDbHeaderBanner"
                            Visibility="Collapsed"
                            Background="{DynamicResource SubtleSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,3"
                            Margin="0,0,0,5">
                        <DockPanel LastChildFill="True">
                            <Button x:Name="BtnAutoBack"
                                    DockPanel.Dock="Left"
                                    Content="{DynamicResource Str.Plc.AutoBackToAll}"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Padding="6,1.5"
                                    FontSize="10"
                                    Click="OnAutoBackToAllClick" />
                            <TextBlock x:Name="TxtAutoActiveDb"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontFamily="Consolas"
                                       FontSize="10.8"
                                       FontWeight="Bold"
                                       Foreground="#2DD4BF" />
                        </DockPanel>
                    </Border>

                    <Border Background="{DynamicResource SubtleSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="4,4,0,0"
                            Padding="6,3.5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="82" />
                                <ColumnDefinition Width="78" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Str.Plc.AutoColName}" FontSize="10.2" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}" />
                            <TextBlock Grid.Column="1" Text="{DynamicResource Str.Plc.AutoColType}" FontSize="10.2" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}" />
                            <TextBlock Grid.Column="2" Text="{DynamicResource Str.Plc.AutoColAddr}" FontSize="10.2" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}" />
                        </Grid>
                    </Border>

                    <Border BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1,0,1,1"
                            CornerRadius="0,0,4,4"
                            Background="{DynamicResource AppBgBrush}">
                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="AutoResultsStack" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>
        </Popup>

        <!-- POPUP 3: EMPTY BOX [F8] SMART INSTRUCTION AUTOCOMPLETE -->
        <Popup x:Name="EmptyBoxPopup"
               StaysOpen="False"
               AllowsTransparency="True"
               Placement="Bottom"
               VerticalOffset="2">
            <Border Background="{DynamicResource SurfaceBgBrush}"
                    BorderBrush="#F59E0B"
                    BorderThickness="1.4"
                    CornerRadius="6"
                    Padding="8"
                    Width="320">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.38" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.Plc.EmptyBoxPrompt}"
                               FontSize="10.4"
                               FontWeight="Bold"
                               Foreground="#F59E0B"
                               Margin="0,0,0,5" />
                    <TextBox x:Name="TbEmptyBoxCmd"
                             Padding="7,4"
                             FontFamily="Consolas"
                             FontSize="12"
                             Background="{DynamicResource InputBgBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="#F59E0B"
                             TextChanged="OnEmptyBoxCmdTextChanged"
                             PreviewKeyDown="OnEmptyBoxCmdPreviewKeyDown" />
                    <Border BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Margin="0,5,0,0"
                            Background="{DynamicResource AppBgBrush}">
                        <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="EmptyBoxSuggestionsStack" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>
        </Popup>

        <!-- POPUP 4: SYSTEM & CLOCK MEMORY CONFIG -->
        <Popup x:Name="PlcMemConfigPopup"
               StaysOpen="False"
               AllowsTransparency="True"
               Placement="Bottom"
               VerticalOffset="3">
            <Border Background="{DynamicResource SurfaceBgBrush}"
                    BorderBrush="{DynamicResource AccentCyanBrush}"
                    BorderThickness="1.4"
                    CornerRadius="6"
                    Padding="12"
                    Width="310">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.38" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.Plc.SysClkTitle}"
                               FontSize="11.8"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentCyanBrush}"
                               Margin="0,0,0,8" />

                    <CheckBox x:Name="CbEnableSysMem"
                              Content="{DynamicResource Str.Plc.SysMemEnable}"
                              FontSize="11"
                              FontWeight="SemiBold"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Margin="0,0,0,4"
                              Checked="OnMemConfigChanged"
                              Unchecked="OnMemConfigChanged" />
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,8">
                        <TextBlock Text="MB" FontFamily="Consolas" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox x:Name="TbSysMemByte" Width="44" Padding="4,2" FontFamily="Consolas" FontSize="11" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource ButtonBorderBrush}" LostFocus="OnMemConfigByteLostFocus" />
                        <TextBlock x:Name="TxtSysMemPreview" FontSize="9.8" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>

                    <CheckBox x:Name="CbEnableClkMem"
                              Content="{DynamicResource Str.Plc.ClkMemEnable}"
                              FontSize="11"
                              FontWeight="SemiBold"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Margin="0,0,0,4"
                              Checked="OnMemConfigChanged"
                              Unchecked="OnMemConfigChanged" />
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,6">
                        <TextBlock Text="MB" FontFamily="Consolas" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox x:Name="TbClkMemByte" Width="44" Padding="4,2" FontFamily="Consolas" FontSize="11" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource ButtonBorderBrush}" LostFocus="OnMemConfigByteLostFocus" />
                        <TextBlock x:Name="TxtClkMemPreview" FontSize="9.8" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>

                    <TextBlock Text="{DynamicResource Str.Plc.SysClkNote}"
                               FontSize="9.8"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,8" />

                    <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,8" />

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="68" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Str.Plc.WatchdogLabel}" FontSize="10.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBox x:Name="TbWatchdogMs" Grid.Column="1" Padding="4,2" FontFamily="Consolas" FontSize="11" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource ButtonBorderBrush}" LostFocus="OnMemConfigByteLostFocus" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="125" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Str.Plc.StopOutModeLabel}" FontSize="10.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <ComboBox x:Name="CbStopOutputMode" Grid.Column="1" FontSize="10.5" SelectionChanged="OnStopOutputModeChanged">
                            <ComboBoxItem Content="{DynamicResource Str.Plc.StopOutZero}" Tag="ResetToZero" />
                            <ComboBoxItem Content="{DynamicResource Str.Plc.StopOutFreeze}" Tag="FreezeLastValue" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
