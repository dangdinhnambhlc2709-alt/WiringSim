<Window x:Class="WiringSim.UI.Dialogs.PlcDefineTagDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str.Plc.DefineTagTitle}"
        Width="440"
        Height="290"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="OnDialogLoaded">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#2563EB" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                    <TextBlock Text="TAG" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="White" />
                </Border>
                <TextBlock Text="{DynamicResource Str.Plc.DefineTagTitle}"
                           FontSize="14.5"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{DynamicResource Str.Plc.DefineTagSubtitle}"
                       Margin="0,3,0,0"
                       FontSize="10.8"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="105" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Str.Plc.TagColName}" VerticalAlignment="Center" Margin="0,0,0,8" FontSize="11.5" />
            <TextBox x:Name="TbTagName" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Padding="6,4" FontFamily="Consolas" FontSize="11.8"
                     Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Str.Plc.TagColType}" VerticalAlignment="Center" Margin="0,0,0,8" FontSize="11.5" />
            <ComboBox x:Name="CbDataType" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" FontSize="11.5" SelectionChanged="OnDataTypeChanged" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Str.Plc.TagColAddr}" VerticalAlignment="Center" Margin="0,0,0,8" FontSize="11.5" />
            <TextBox x:Name="TbAddress" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Padding="6,4" FontFamily="Consolas" FontSize="11.8"
                     Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource ButtonBorderBrush}" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Str.Plc.TagColComment}" VerticalAlignment="Center" FontSize="11.5" />
            <TextBox x:Name="TbComment" Grid.Row="3" Grid.Column="1" Padding="6,4" FontSize="11.5"
                     Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource ButtonBorderBrush}" />
        </Grid>

        <TextBlock x:Name="TxtError"
                   Grid.Row="2"
                   Margin="0,6,0,0"
                   FontSize="10.8"
                   Foreground="#EF4444"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button IsDefault="True"
                    MinWidth="84"
                    Padding="14,5"
                    Margin="0,0,8,0"
                    FontSize="11.5"
                    FontWeight="SemiBold"
                    BorderBrush="{DynamicResource AccentCyanBrush}"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Content="{DynamicResource Str.Plc.CallOptOk}"
                    Click="OnOkClick" />
            <Button IsCancel="True"
                    MinWidth="84"
                    Padding="14,5"
                    FontSize="11.5"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Content="{DynamicResource Str.Plc.CallOptCancel}"
                    Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
