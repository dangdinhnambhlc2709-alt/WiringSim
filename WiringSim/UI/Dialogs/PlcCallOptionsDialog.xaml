<Window x:Class="WiringSim.UI.Dialogs.PlcCallOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str.Plc.CallOptTitle}"
        Width="520"
        Height="340"
        MinWidth="480"
        MinHeight="310"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="OnDialogLoaded">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#009999" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                    <TextBlock Text="DB" FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" Foreground="White" />
                </Border>
                <TextBlock Text="{DynamicResource Str.Plc.CallOptTitle}"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="TxtSubtitle"
                       Margin="0,4,0,0"
                       FontSize="11.5"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <!-- BODY: LEFT (Single instance card) + RIGHT (Data block properties) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: Single instance -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SubtleSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8">
                <Border Background="{DynamicResource MenuHoverBrush}"
                        BorderBrush="{DynamicResource AccentCyanBrush}"
                        BorderThickness="1.5"
                        CornerRadius="5"
                        Padding="10,12"
                        VerticalAlignment="Top">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- DB Icon -->
                        <Border Width="44"
                                Height="44"
                                CornerRadius="7"
                                Background="#0F766E"
                                BorderBrush="#2DD4BF"
                                BorderThickness="1.5"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,8">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="DB"
                                           FontFamily="Consolas"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center" />
                                <Border Height="2" Width="22" Background="#99F6E4" CornerRadius="1" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{DynamicResource Str.Plc.CallOptSingleInstance}"
                                   FontSize="11.8"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" />
                        <TextBlock Text="{DynamicResource Str.Plc.CallOptSingleInstanceDesc}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
            </Border>

            <!-- RIGHT: Data block frame -->
            <Border Grid.Column="2"
                    Background="{DynamicResource SurfaceBgBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.Plc.CallOptDbGroup}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentCyanBrush}"
                               Margin="0,0,0,10" />

                    <!-- Name row -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{DynamicResource Str.Plc.CallOptName}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="TbDbName"
                                 Grid.Column="1"
                                 Padding="7,4"
                                 FontSize="12"
                                 FontFamily="Consolas"
                                 Background="{DynamicResource InputBgBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource AccentCyanBrush}" />
                    </Grid>

                    <!-- Number row with spinner -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{DynamicResource Str.Plc.CallOptNumber}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="TbDbNumber"
                                     Width="68"
                                     Padding="7,4"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     TextAlignment="Right"
                                     IsEnabled="False"
                                     Background="{DynamicResource InputBgBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource ButtonBorderBrush}"
                                     TextChanged="OnDbNumberTextChanged" />
                            <StackPanel Margin="3,0,0,0" VerticalAlignment="Center">
                                <Button x:Name="BtnNumUp"
                                        Content="▲"
                                        Width="22"
                                        Height="14"
                                        Padding="0"
                                        FontSize="7.5"
                                        IsEnabled="False"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        Click="OnNumberUpClick" />
                                <Button x:Name="BtnNumDown"
                                        Content="▼"
                                        Width="22"
                                        Height="14"
                                        Padding="0"
                                        FontSize="7.5"
                                        IsEnabled="False"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        Click="OnNumberDownClick" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="TxtDbPreview"
                                   Grid.Column="2"
                                   FontFamily="Consolas"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="#2DD4BF"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0" />
                    </Grid>

                    <!-- Radio: Automatic / Manual -->
                    <Border Background="{DynamicResource SubtleSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10,8">
                        <StackPanel>
                            <RadioButton x:Name="RbAutomatic"
                                         GroupName="DbNumberMode"
                                         IsChecked="True"
                                         FontSize="11.5"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         Content="{DynamicResource Str.Plc.CallOptAuto}"
                                         Checked="OnModeRadioChanged" />
                            <TextBlock x:Name="TxtAutoDesc"
                                       Margin="20,2,0,8"
                                       FontSize="10.3"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />

                            <RadioButton x:Name="RbManual"
                                         GroupName="DbNumberMode"
                                         FontSize="11.5"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         Content="{DynamicResource Str.Plc.CallOptManual}"
                                         Checked="OnModeRadioChanged" />
                            <TextBlock Margin="20,2,0,0"
                                       FontSize="10.3"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{DynamicResource Str.Plc.CallOptManualDesc}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- FOOTER BUTTONS -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="BtnOk"
                    IsDefault="True"
                    MinWidth="84"
                    Padding="16,5"
                    Margin="0,0,8,0"
                    FontSize="11.5"
                    FontWeight="SemiBold"
                    BorderBrush="{DynamicResource AccentCyanBrush}"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Content="{DynamicResource Str.Plc.CallOptOk}"
                    Click="OnOkClick" />
            <Button x:Name="BtnCancel"
                    IsCancel="True"
                    MinWidth="84"
                    Padding="16,5"
                    FontSize="11.5"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Content="{DynamicResource Str.Plc.CallOptCancel}"
                    Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
