<Window x:Class="WiringSim.UI.Dialogs.PlcCalculateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str.Plc.CalcDlgTitle}"
        Width="560"
        Height="430"
        MinWidth="500"
        MinHeight="380"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="OnDialogLoaded">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#EC4899" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                    <TextBlock Text="fx" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="White" />
                </Border>
                <TextBlock Text="{DynamicResource Str.Plc.CalcDlgTitle}"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{DynamicResource Str.Plc.CalcDlgSubtitle}"
                       Margin="0,3,0,0"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- DATA TYPE & INPUT COUNT -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{DynamicResource Str.Plc.CalcDataType}"
                       FontSize="11.5"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <ComboBox x:Name="CbDataType"
                      Grid.Column="1"
                      FontSize="11.5"
                      FontFamily="Consolas" />
            <TextBlock x:Name="TxtDetectedInputs"
                       Grid.Column="2"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontFamily="Consolas"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="#2DD4BF" />
        </Grid>

        <!-- EQUATION EDITOR & FUNCTIONS PALETTE -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="74" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{DynamicResource Str.Plc.CalcExprLabel}"
                       FontSize="11.2"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentCyanBrush}"
                       Margin="0,0,0,4" />

            <TextBox x:Name="TbExpression"
                     Grid.Row="1"
                     AcceptsReturn="False"
                     TextWrapping="Wrap"
                     Padding="8,6"
                     FontFamily="Consolas"
                     FontSize="12.5"
                     Background="{DynamicResource InputBgBrush}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource AccentCyanBrush}"
                     TextChanged="OnExpressionChanged" />

            <TextBlock Grid.Row="2"
                       Text="{DynamicResource Str.Plc.CalcFuncsLabel}"
                       FontSize="10.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,10,0,5" />

            <Border Grid.Row="3"
                    Background="{DynamicResource SubtleSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="7">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="FuncsWrapPanel" />
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- LIVE VALIDATION -->
        <TextBlock x:Name="TxtValidation"
                   Grid.Row="3"
                   Margin="0,8,0,0"
                   FontSize="11"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />

        <!-- FOOTER -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button x:Name="BtnOk"
                    IsDefault="True"
                    MinWidth="86"
                    Padding="16,5"
                    Margin="0,0,8,0"
                    FontSize="11.5"
                    FontWeight="SemiBold"
                    BorderBrush="{DynamicResource AccentCyanBrush}"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Content="{DynamicResource Str.Plc.CallOptOk}"
                    Click="OnOkClick" />
            <Button IsCancel="True"
                    MinWidth="86"
                    Padding="16,5"
                    FontSize="11.5"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Content="{DynamicResource Str.Plc.CallOptCancel}"
                    Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
