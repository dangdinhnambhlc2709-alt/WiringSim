<Window x:Class="WiringSim.UI.Dialogs.PlcLadderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WiringSim.UI.Controls"
        Title="{DynamicResource Str.Plc.WindowTitle}"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1120"
        Height="720"
        MinWidth="680"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ShowInTaskbar="True"
        Background="{DynamicResource AppBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      CornerRadius="8"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="OuterWindowBorder"
            Background="{DynamicResource AppBgBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom Title Bar đồng bộ Theme & hỗ trợ Minimize / Maximize / Close -->
            <Border x:Name="TitleBarBorder"
                    Grid.Row="0"
                    Background="{DynamicResource TitleBarBgBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="7,7,0,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Border Background="#009999" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                            <TextBlock Text="PLC" FontSize="10" FontWeight="Bold" Foreground="White" />
                        </Border>
                        <TextBlock x:Name="TxtWindowHeader"
                                   Text="{DynamicResource Str.Plc.WindowTitle}"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource CaptionButtonStyle}"
                                Content="─"
                                Click="OnMinimizeClick"
                                ToolTip="{DynamicResource Str.TitleBar.Minimize}" />
                        <Button x:Name="BtnMaximizeRestore"
                                Style="{StaticResource CaptionButtonStyle}"
                                Content="☐"
                                Click="OnMaximizeRestoreClick"
                                ToolTip="{DynamicResource Str.TitleBar.Maximize}" />
                        <Button Style="{StaticResource CloseCaptionButtonStyle}"
                                Content="✕"
                                Click="OnCloseClick"
                                ToolTip="{DynamicResource Str.Plc.HideEditorTip}" />
                    </StackPanel>

                    <Grid Background="Transparent" />
                </DockPanel>
            </Border>

            <!-- Trình lập trình PLC Ladder chuẩn TIA Portal -->
            <controls:PlcLadderEditorControl x:Name="LadderEditor" Grid.Row="1" />
        </Grid>
    </Border>
</Window>
